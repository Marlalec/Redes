# No guardes contrasenas reales en Git.
# La opcion recomendada es ejecutar iniciar-docker.cmd: el script crea .env
# automaticamente con contrasenas aleatorias fuertes.

MSSQL_SA_PASSWORD=CAMBIAR_Aa1_Password_SA_Con_12_Caracteres
DB_PASSWORD=CAMBIAR_Aa1_Password_App_Con_12_Caracteres
APP_ADMIN_EMAIL=admin@osidev.local
APP_ADMIN_NAME=Administrador OSI
APP_ADMIN_PASSWORD=CAMBIAR_Aa1_Password_Web_Con_12_Caracteres
SESSION_COOKIE_SECURE=false

# Puertos publicados en Windows. Dentro de Docker se conservan 80, 8080 y 1433.
FRONTEND_PORT=5173
BACKEND_PORT=8080
SQLSERVER_PORT=14330
